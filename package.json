{
  "name": "sfl",
  "private": true,
  "workspaces": [
    "api",
    "web",
    "chrome-extension",
    "cli"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "test": "vitest run --config vitest.config.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "picomatch": ">=4.0.4",
      "cookie": "^0.7.0",
      "ws": ">=8.20.1",
      "undici": ">=8.12.2",
      "postcss": ">=8.5.23",
      "@sveltejs/kit": "^2.70.2",
      "sharp": ">=0.35.5",
      "esbuild": ">=0.28.1",
      "@vitest/mocker": ">=5.0.3",
      "devalue": "^5.9.3",
      "source-map-js": ">=1.2.2"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "vitest": "^5.0.3"
  }
}
